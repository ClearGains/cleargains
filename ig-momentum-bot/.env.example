# Momentum Testbot settings — copied to .env on the server.
# The IG demo login comes from the bot server's own .env (same demo account),
# so it isn't repeated here. Set IG_USERNAME / IG_PASSWORD / IG_API_KEY here
# only to override it.
IG_ENV=demo
IG_ACC_NUMBER=Z6AFSI

# Safety switches (re-read every scan, no restart needed)
DRY_RUN=true
KILL_SWITCH=false

# Strategy settings (original defaults)
SIZE_PER_POINT=1
MIN_STRENGTH=75
AUTO_CLOSE=true
SCAN_INTERVAL_SECONDS=300
# Comma-separated market names to override the default 7, e.g.
# MARKETS=FTSE 100,S&P 500,Wall Street,Germany 40,Japan 225,GBP/USD,AUD/USD

# Conviction filters: move still holding vs today's open, trend vs 20-day average,
# and no index trades in the first N minutes of the exchange session
CONFIRM_INTRADAY=true
TREND_FILTER=true
OPENING_SKIP_MINUTES=30
# Stops / risk / choppy-day guard
RISK_PER_TRADE_GBP=20
INDEX_STOP_PCT=0.3
MAX_QUOTE_AGE_MINUTES=30
COOLDOWN_MINUTES=60
MAX_LOSSES_PER_DAY=2
